# ==============================================================================
# CampusSaathi — Your Intelligent College Companion
# Environment Configuration
# ==============================================================================

# MongoDB Atlas Connection URI (Free Tier M0 or local replica set)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campus_saathi?retryWrites=true&w=majority

# Google Gemini API Key (From Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret for Stateless Session Cookies (Generate with: openssl rand -base64 32)
AUTH_SECRET=your_super_secret_auth_key_at_least_32_characters_long

# Vector Search Provider: "atlas" (MongoDB Atlas Vector Search) or "memory" (In-Memory Cosine Fallback)
VECTOR_SEARCH_PROVIDER=atlas

# Embedding Model (Current recommended: gemini-embedding-001)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Chat Generation Model (Current recommended: gemini-2.0-flash)
GEMINI_CHAT_MODEL=gemini-2.0-flash

# Base App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node Environment
NODE_ENV=development
